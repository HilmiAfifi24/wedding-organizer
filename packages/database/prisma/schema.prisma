// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  VENDOR
  ADMIN
}

enum BookingStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AuditModule {
  USER_MANAGEMENT
  VENDOR_MANAGEMENT
}

enum VendorStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String?
  passwordHash    String?
  role            Role      @default(USER)
  accessProfileId String?
  deletedAt       DateTime?
  deletedBy       String?
  suspendedAt     DateTime?
  suspendedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor                Vendor?
  bookings              Booking[]
  reviews               Review[]
  verifiedPaymentProofs PaymentProof[]
  accessProfile         AccessProfile? @relation(fields: [accessProfileId], references: [id])
  deletedByUser         User?          @relation("DeletedUsers", fields: [deletedBy], references: [id], onDelete: SetNull)
  deletedUsers          User[]         @relation("DeletedUsers")
  suspendedByUser       User?          @relation("SuspendedUsers", fields: [suspendedBy], references: [id], onDelete: SetNull)
  suspendedUsers        User[]         @relation("SuspendedUsers")
  actorAuditLogs        AuditLog[]     @relation("ActorAuditLogs")
  approvedVendors       Vendor[]       @relation("VendorApprovedBy")
  rejectedVendors       Vendor[]       @relation("VendorRejectedBy")
  suspendedVendors      Vendor[]       @relation("VendorSuspendedBy")
  deletedVendors        Vendor[]       @relation("VendorDeletedBy")

  @@index([accessProfileId])
  @@index([deletedAt])
  @@index([suspendedAt])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendors Vendor[]
}

model Vendor {
  id               String       @id @default(uuid())
  ownerId          String       @unique
  name             String
  description      String?
  location         String?
  contactInfo      String?
  phoneNumber      String?
  priceRange       String?
  categoryId       String?
  status           VendorStatus @default(PENDING_VERIFICATION)
  approvedAt       DateTime?
  approvedBy       String?
  rejectedAt       DateTime?
  rejectedBy       String?
  rejectionReason  String?
  suspendedAt      DateTime?
  suspendedBy      String?
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  owner            User         @relation(fields: [ownerId], references: [id])
  category         Category?    @relation(fields: [categoryId], references: [id])
  approvedByUser   User?        @relation("VendorApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  rejectedByUser   User?        @relation("VendorRejectedBy", fields: [rejectedBy], references: [id], onDelete: SetNull)
  suspendedByUser  User?        @relation("VendorSuspendedBy", fields: [suspendedBy], references: [id], onDelete: SetNull)
  deletedByUser    User?        @relation("VendorDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  services         Service[]
  bookings         Booking[]
  reviews          Review[]
  portfolio        Portfolio[]

  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
}

model Service {
  id          String   @id @default(uuid())
  vendorId    String
  name        String
  description String?
  price       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor   Vendor    @relation(fields: [vendorId], references: [id])
  bookings Booking[]

  @@index([vendorId])
}

model Booking {
  id          String        @id @default(uuid())
  userId      String
  vendorId    String
  serviceId   String?
  bookedAt    DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  service     Service?     @relation(fields: [serviceId], references: [id])
  paymentProof PaymentProof?
  review      Review?

  @@index([userId])
  @@index([vendorId])
  @@index([serviceId])
}

model PaymentProof {
  id           String   @id @default(uuid())
  bookingId    String   @unique
  fileUrl      String
  note         String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking    Booking @relation(fields: [bookingId], references: [id])
  verifiedBy User?   @relation(fields: [verifiedById], references: [id])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  userId    String
  vendorId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@index([userId])
  @@index([vendorId])
}

model Portfolio {
  id          String    @id @default(uuid())
  vendorId    String
  title       String?
  description String?
  mediaUrl    String
  mediaType   MediaType
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

model AccessMenu {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  path      String?
  icon      String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent      AccessMenu?      @relation("AccessMenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    AccessMenu[]     @relation("AccessMenuHierarchy")
  permissions AccessPermission[]

  @@index([parentId])
  @@index([sortOrder])
}

model AccessProfile {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions AccessPermission[]
}

model AccessPermission {
  id              String   @id @default(uuid())
  accessProfileId String
  accessMenuId    String
  canView         Boolean  @default(false)
  canInsert       Boolean  @default(false)
  canUpdate       Boolean  @default(false)
  canUpsert       Boolean  @default(false)
  canDelete       Boolean  @default(false)
  canHistory      Boolean  @default(false)
  customEvents    Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accessProfile AccessProfile @relation(fields: [accessProfileId], references: [id], onDelete: Cascade)
  accessMenu    AccessMenu    @relation(fields: [accessMenuId], references: [id], onDelete: Cascade)

  @@unique([accessProfileId, accessMenuId])
  @@index([accessProfileId])
  @@index([accessMenuId])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String
  module     AuditModule
  action     String
  targetId   String
  beforeData Json?
  afterData  Json?
  createdAt  DateTime    @default(now())

  actor User @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([module, action])
  @@index([targetId])
  @@index([createdAt])
}
