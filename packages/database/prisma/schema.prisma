// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  VENDOR
  ADMIN
}

enum BookingStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentType {
  DP
  INSTALLMENT
  FINAL_PAYMENT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PaymentProofStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentTermStatus {
  UNPAID
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  OVERDUE
}

enum PaymentReminderChannel {
  WHATSAPP
}

enum PaymentReminderType {
  D7
  D1
  D0
  OVERDUE
}

enum PaymentReminderStatus {
  PENDING
  SENT
  FAILED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum ReviewModerationAction {
  HIDE
  UNHIDE
  DELETE
}

enum AuditModule {
  USER_MANAGEMENT
  VENDOR_MANAGEMENT
  VENDOR_PROFILE
  VENDOR_PAYMENTS
  BOOKING_MANAGEMENT
  USER_BOOKINGS
  USER_PAYMENTS
  PAYMENT_MONITORING
  REVIEW_MODERATION
}

enum VendorStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phoneNumber     String?   @unique
  name            String?
  passwordHash    String?
  role            Role      @default(USER)
  accessProfileId String?
  deletedAt       DateTime?
  deletedBy       String?
  suspendedAt     DateTime?
  suspendedBy     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor                Vendor?
  bookings              Booking[]
  reviews               Review[]
  accessProfile         AccessProfile? @relation(fields: [accessProfileId], references: [id])
  deletedByUser         User?          @relation("DeletedUsers", fields: [deletedBy], references: [id], onDelete: SetNull)
  deletedUsers          User[]         @relation("DeletedUsers")
  suspendedByUser       User?          @relation("SuspendedUsers", fields: [suspendedBy], references: [id], onDelete: SetNull)
  suspendedUsers        User[]         @relation("SuspendedUsers")
  actorAuditLogs        AuditLog[]     @relation("ActorAuditLogs")
  changedBookingStatuses BookingStatusHistory[] @relation("BookingStatusChangedBy")
  uploadedPaymentProofs PaymentProof[] @relation("UploadedPaymentProofs")
  verifiedPaymentProofs PaymentProof[] @relation("VerifiedPaymentProofs")
  rejectedPaymentProofs PaymentProof[] @relation("RejectedPaymentProofs")
  overriddenPaymentProofs PaymentProof[] @relation("OverriddenPaymentProofs")
  changedPaymentProofStatuses PaymentProofStatusHistory[] @relation("PaymentProofStatusChangedBy")
  hiddenReviews          Review[]                   @relation("HiddenReviews")
  deletedReviews         Review[]                   @relation("DeletedReviews")
  moderatedReviews       ReviewModerationHistory[]  @relation("ReviewModeratedBy")
  approvedVendors       Vendor[]       @relation("VendorApprovedBy")
  rejectedVendors       Vendor[]       @relation("VendorRejectedBy")
  suspendedVendors      Vendor[]       @relation("VendorSuspendedBy")
  deletedVendors        Vendor[]       @relation("VendorDeletedBy")

  @@index([accessProfileId])
  @@index([deletedAt])
  @@index([suspendedAt])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendors Vendor[]
}

model Vendor {
  id               String       @id @default(uuid())
  ownerId          String       @unique
  name             String
  businessName     String?
  description      String?
  businessType     String?
  establishedYear  Int?
  location         String?
  businessAddress  String?
  city             String?
  province         String?
  postalCode       String?
  contactInfo      String?
  phoneNumber      String?
  whatsappNumber   String?
  website          String?
  logoUrl          String?
  coverImageUrl    String?
  instagramUrl     String?
  tiktokUrl        String?
  facebookUrl      String?
  youtubeUrl       String?
  priceRange       String?
  categoryId       String?
  status           VendorStatus @default(PENDING_VERIFICATION)
  approvedAt       DateTime?
  approvedBy       String?
  rejectedAt       DateTime?
  rejectedBy       String?
  rejectionReason  String?
  resubmittedAt    DateTime?
  suspendedAt      DateTime?
  suspendedBy      String?
  suspensionReason String?
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  owner            User         @relation(fields: [ownerId], references: [id])
  category         Category?    @relation(fields: [categoryId], references: [id])
  approvedByUser   User?        @relation("VendorApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  rejectedByUser   User?        @relation("VendorRejectedBy", fields: [rejectedBy], references: [id], onDelete: SetNull)
  suspendedByUser  User?        @relation("VendorSuspendedBy", fields: [suspendedBy], references: [id], onDelete: SetNull)
  deletedByUser    User?        @relation("VendorDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  services         Service[]
  bookings         Booking[]
  reviews          Review[]
  portfolio        Portfolio[]

  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
  @@unique([phoneNumber])
}

model Service {
  id          String   @id @default(uuid())
  vendorId    String
  name        String
  description String?
  price       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor   Vendor    @relation(fields: [vendorId], references: [id])
  bookings Booking[]
  adats    Adat[]

  @@index([vendorId])
}

model Adat {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  services  Service[]
}


model Booking {
  id             String        @id @default(uuid())
  bookingCode    String        @unique
  userId         String
  vendorId       String
  serviceId      String?
  bookedAt       DateTime
  eventDate      DateTime
  eventLocation  String
  customerName   String
  customerPhone  String
  customerEmail  String
  guestCount     Int?
  status         BookingStatus @default(PENDING)
  notes          String?
  specialRequest String?
  totalAmount    Int           @default(0)
  paymentStatus  PaymentStatus @default(UNPAID)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user          User                   @relation(fields: [userId], references: [id])
  vendor        Vendor                 @relation(fields: [vendorId], references: [id])
  service       Service?               @relation(fields: [serviceId], references: [id])
  paymentTerms  PaymentTerm[]
  paymentProofs PaymentProof[]
  statusHistory BookingStatusHistory[]
  review        Review?

  @@index([userId])
  @@index([vendorId])
  @@index([serviceId])
  @@index([bookingCode])
  @@index([eventDate])
  @@index([paymentStatus])
  @@index([userId, vendorId, serviceId, eventDate, status])
}

model BookingStatusHistory {
  id             String        @id @default(uuid())
  bookingId      String
  previousStatus BookingStatus?
  newStatus      BookingStatus
  changedById    String?
  note           String?
  createdAt      DateTime      @default(now())

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation("BookingStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([changedById])
}

model PaymentTerm {
  id                 String               @id @default(uuid())
  bookingId          String
  type               PaymentType
  amount             Int
  status             PaymentTermStatus    @default(UNPAID)
  dueDate            DateTime?
  sequence           Int
  lastReminderSentAt DateTime?
  lastReminderType   PaymentReminderType?
  overdueMarkedAt    DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  booking            Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentProofs      PaymentProof[]
  reminderLogs       PaymentReminderLog[]

  @@index([bookingId])
  @@index([status])
  @@unique([bookingId, sequence])
}

model PaymentReminderLog {
  id                String                @id @default(uuid())
  paymentTermId     String
  channel           PaymentReminderChannel
  reminderType      PaymentReminderType
  recipientPhone    String
  provider          String
  providerMessageId String?
  status            PaymentReminderStatus @default(PENDING)
  requestPayload    Json?
  responsePayload   Json?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())

  paymentTerm PaymentTerm @relation(fields: [paymentTermId], references: [id], onDelete: Cascade)

  @@index([paymentTermId, createdAt])
  @@index([paymentTermId, reminderType, status])
}

model PaymentProof {
  id               String             @id @default(uuid())
  bookingId        String
  paymentTermId    String
  uploadedById     String
  amount           Int
  fileUrl          String
  note             String?
  status           PaymentProofStatus @default(PENDING)
  verifiedById     String?
  verifiedAt       DateTime?
  rejectedById     String?
  rejectedAt       DateTime?
  rejectionReason  String?
  verificationNote String?
  overriddenById   String?
  overriddenAt     DateTime?
  overrideReason   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  booking       Booking                   @relation(fields: [bookingId], references: [id])
  paymentTerm   PaymentTerm               @relation(fields: [paymentTermId], references: [id], onDelete: Cascade)
  uploadedBy    User                      @relation("UploadedPaymentProofs", fields: [uploadedById], references: [id], onDelete: Cascade)
  verifiedBy    User?                     @relation("VerifiedPaymentProofs", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedBy    User?                     @relation("RejectedPaymentProofs", fields: [rejectedById], references: [id], onDelete: SetNull)
  overriddenBy  User?                     @relation("OverriddenPaymentProofs", fields: [overriddenById], references: [id], onDelete: SetNull)
  statusHistory PaymentProofStatusHistory[]

  @@index([bookingId])
  @@index([paymentTermId])
  @@index([uploadedById])
  @@index([status])
  @@index([verifiedById])
  @@index([rejectedById])
  @@index([overriddenById])
}

model PaymentProofStatusHistory {
  id             String             @id @default(uuid())
  paymentProofId String
  previousStatus PaymentProofStatus?
  newStatus      PaymentProofStatus
  changedById    String?
  note           String?
  isOverride     Boolean            @default(false)
  createdAt      DateTime           @default(now())

  paymentProof PaymentProof @relation(fields: [paymentProofId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation("PaymentProofStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([paymentProofId, createdAt])
  @@index([changedById])
}

model Review {
  id               String       @id @default(uuid())
  bookingId        String       @unique
  userId           String
  vendorId         String
  rating           Int
  comment          String?
  status           ReviewStatus @default(VISIBLE)
  hiddenAt         DateTime?
  hiddenById       String?
  deletedAt        DateTime?
  deletedById      String?
  moderationReason String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  booking          Booking                    @relation(fields: [bookingId], references: [id])
  user             User                       @relation(fields: [userId], references: [id])
  vendor           Vendor                     @relation(fields: [vendorId], references: [id])
  hiddenBy         User?                      @relation("HiddenReviews", fields: [hiddenById], references: [id], onDelete: SetNull)
  deletedBy        User?                      @relation("DeletedReviews", fields: [deletedById], references: [id], onDelete: SetNull)
  moderationHistory ReviewModerationHistory[]

  @@index([userId])
  @@index([vendorId])
  @@index([status])
  @@index([hiddenAt])
  @@index([deletedAt])
}

model ReviewModerationHistory {
  id         String                 @id @default(uuid())
  reviewId    String
  action      ReviewModerationAction
  reason      String?
  actorId     String?
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime              @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  actor  User?  @relation("ReviewModeratedBy", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt])
  @@index([actorId])
}

model Portfolio {
  id          String    @id @default(uuid())
  vendorId    String
  title       String?
  description String?
  mediaUrl    String
  mediaType   MediaType
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
}

model AccessMenu {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  path      String?
  icon      String?
  parentId  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent      AccessMenu?      @relation("AccessMenuHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    AccessMenu[]     @relation("AccessMenuHierarchy")
  permissions AccessPermission[]

  @@index([parentId])
  @@index([sortOrder])
}

model AccessProfile {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions AccessPermission[]
}

model AccessPermission {
  id              String   @id @default(uuid())
  accessProfileId String
  accessMenuId    String
  canView         Boolean  @default(false)
  canInsert       Boolean  @default(false)
  canUpdate       Boolean  @default(false)
  canUpsert       Boolean  @default(false)
  canDelete       Boolean  @default(false)
  canHistory      Boolean  @default(false)
  customEvents    Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accessProfile AccessProfile @relation(fields: [accessProfileId], references: [id], onDelete: Cascade)
  accessMenu    AccessMenu    @relation(fields: [accessMenuId], references: [id], onDelete: Cascade)

  @@unique([accessProfileId, accessMenuId])
  @@index([accessProfileId])
  @@index([accessMenuId])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String
  module     AuditModule
  action     String
  targetId   String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor User @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([module, action])
  @@index([targetId])
  @@index([createdAt])
}
